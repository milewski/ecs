{
    "name": "milewski/ecs",
    "description": "Standard code style configuration",
    "require": {
        "php": ">=8.4",
        "nikic/php-parser": "^5.9",
        "symplify/easy-coding-standard": "^13.3.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Milewski\\ECS\\": "src/"
        },
        "files": [
            "helpers/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Milewski\\ECS\\Tests\\": "tests/"
        },
        "files": [
            "tests/Support/complex_return_app.php"
        ]
    },
    "scripts": {
        "test": "phpunit --do-not-record-test-run-history tests"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
